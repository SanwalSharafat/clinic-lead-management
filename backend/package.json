{
  "name": "clinic-lead-management",
  "version": "1.0.0",
  "description": "Clinic Lead Management & Automation System for a single dental/medical clinic",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn src/app.ts",
    "test": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src/**/*.ts",
    "seed": "ts-node src/seed.ts",
    "migrate": "ts-node src/migrate.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.21.0",
    "zod": "^3.23.0",
    "@google/generative-ai": "^0.21.0",
    "googleapis": "^144.0.0",
    "dotenv": "^16.4.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^10.0.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "testMatch": ["**/*.test.ts"],
    "setupFiles": ["<rootDir>/tests/setup.ts"],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/app.ts"
    ]
  }
}