# ========================================
# Clinic Lead Management - Environment Config
# ========================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- WhatsApp Business (Meta Graph API) ---
WHATSAPP_APP_ID=123456789012345
WHATSAPP_APP_SECRET=your-facebook-app-secret
WHATSAPP_ACCESS_TOKEN=EAAG...your-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-webhook-token
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0

# Backward-compatible legacy keys (optional)
WATI_API_KEY=your-legacy-wati-api-key
WATI_BASE_URL=https://api.wati.io/v3
WATI_PHONE_NUMBER=your-legacy-clinic-phone-number

# --- Google Calendar ---
GOOGLE_CALENDAR_CLIENT_ID=your-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/auth/calendar/callback
GOOGLE_CALENDAR_CALENDAR_ID=primary
GOOGLE_CALENDAR_REFRESH_TOKEN=your-refresh-token

# --- Staff Notification ---
STAFF_PHONE_NUMBER=+1234567890
STAFF_EMAIL=staff@clinic.com

# --- Security ---
WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
